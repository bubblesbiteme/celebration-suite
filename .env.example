SITE_URL=https://planner.sageandcelebration.com
PLATFORM_NAME=Celebration Suite
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
SUPABASE_ANON_KEY=
SESSION_SECRET=replace-with-a-long-random-secret
INTEGRATION_ENCRYPTION_KEY=replace-with-32-byte-base64-or-long-random-secret
PLATFORM_OWNER_EMAIL=support@sageandcelebration.com
PLATFORM_FROM_EMAIL=Celebration Suite <support@sageandcelebration.com>
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SINGLE_EVENT=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=replace-with-a-long-random-secret-or-leave-SESSION_SECRET-fallback
PLATFORM_ADMIN_KEY=replace-with-another-long-random-secret
PUBLIC_PRICE_SINGLE=99
PUBLIC_PRICE_MONTHLY=59
PUBLIC_PRICE_ANNUAL=499

# Platform transactional email (password resets / account emails)
RESEND_API_KEY=
PLATFORM_FROM_EMAIL=support@sageandcelebration.com
PLATFORM_FROM_NAME=Celebration Suite

# Google Calendar OAuth (uses same Google OAuth app if desired)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=

# QuickBooks Online OAuth
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENV=sandbox
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=

# Inbound communications (required for full inbound email/SMS functionality)
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_DOMAIN=
TELNYX_PUBLIC_KEY=
# TELNYX API credentials are normally stored per tenant in Brand & Integrations.

# Support alerts
SUPPORT_NOTIFICATION_EMAIL=

# Optional custom-domain automation (verified domains can also be added manually in Netlify)
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# Browser Web Push (generate a VAPID key pair; keep the private key server-side)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Event Workspace AI Assistant (optional; AI tab shows a clear configuration error until set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
